# Copy the required values into your private .env. Never commit the real values.
NOTES_SCRIPT_URL=https://bolt-hole-backend.karl-582.workers.dev
SHORTLIST_URL=https://karl-reforged.github.io/bolt-hole/
BOLT_ADMIN_TOKEN=replace-with-the-same-strong-token-as-worker-admin-token

# Existing scrape and email settings (examples only)
DOMAIN_CLIENT_ID=replace-me
DOMAIN_CLIENT_SECRET=replace-me
APIFY_API_TOKEN=replace-me
APIFY_REA_ACTOR=one-api/realestate-com-au-scraper
# 0 means all target postcodes; use a positive number only for local probes.
APIFY_MAX_POSTCODES=0
BOLT_MIN_REA=5
RESEND_API_KEY=replace-me
GEORGE_EMAIL=george@example.com
FROM_ADDRESS=Bolt Hole <verified@example.com>
